    "@types/react-dom": "^19.2.2",
    "babel-plugin-import": "^1.13.8",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "antd": ">=5.0.0 - <=6.x",
    "react": ">=18.0.0 - <20.0.0",
